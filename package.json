{
  "name": "vscode-journal",
  "displayName": "Journal",
  "description": "A simple blog extension that stores entries in markdown, with a tree view browser and full-text search",
  "version": "1.1.0",
  "publisher": "jsldvr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsldvr/vscode-journal.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "blog",
    "journal",
    "markdown",
    "writing"
  ],
  "activationEvents": [
    "onCommand:vsJournal.newEntry",
    "onCommand:vsJournal.openBlog",
    "onCommand:vsJournal.refreshEntries",
    "onCommand:vsJournal.search",
    "onCommand:vsJournal.clearSearch",
    "onCommand:vsJournal.openEntry",
    "onCommand:vsJournal.searchByTag",
    "onCommand:vsJournal.setBlogPath",
    "onCommand:vsJournal.rescanEntries",
    "onCommand:vsJournal.uploadMedia",
    "onCommand:vsJournal.refreshMediaLibrary",
    "onView:vsJournal.search"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vsJournal.newEntry",
        "title": "New Blog Entry",
        "category": "Journal",
        "icon": "$(add)"
      },
      {
        "command": "vsJournal.openBlog",
        "title": "Open Blog",
        "category": "Journal",
        "icon": "$(book)"
      },
      {
        "command": "vsJournal.refreshEntries",
        "title": "Refresh",
        "category": "Journal",
        "icon": "$(refresh)"
      },
      {
        "command": "vsJournal.search",
        "title": "Search Blog",
        "category": "Journal",
        "icon": "$(search)"
      },
      {
        "command": "vsJournal.clearSearch",
        "title": "Clear Search",
        "category": "Journal",
        "icon": "$(clear-all)"
      },
      {
        "command": "vsJournal.openEntry",
        "title": "Open Entry",
        "category": "Journal"
      },
      {
        "command": "vsJournal.searchByTag",
        "title": "Search by Tag",
        "category": "Journal"
      },
      {
        "command": "vsJournal.setBlogPath",
        "title": "Set Blog Directory",
        "category": "Journal",
        "icon": "$(folder)"
      },
      {
        "command": "vsJournal.rescanEntries",
        "title": "Rescan All Entries",
        "category": "Journal",
        "icon": "$(sync)"
      },
      {
        "command": "vsJournal.uploadMedia",
        "title": "Upload Media",
        "category": "Journal",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "vsJournal.refreshMediaLibrary",
        "title": "Refresh Media Library",
        "category": "Journal",
        "icon": "$(refresh)"
      }
    ],
    "views": {
      "vsJournal": [
        {
          "type": "webview",
          "id": "vsJournal.search",
          "name": "Journal",
          "when": "true"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vsJournal",
          "title": "Journal",
          "icon": "resources/journal-icon.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "vsJournal.newEntry",
          "when": "view == vsJournal.search",
          "group": "navigation"
        },
        {
          "command": "vsJournal.refreshEntries",
          "when": "view == vsJournal.search",
          "group": "navigation"
        },
        {
          "command": "vsJournal.rescanEntries",
          "when": "view == vsJournal.search",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "vsJournal.newEntry"
        },
        {
          "command": "vsJournal.openBlog"
        },
        {
          "command": "vsJournal.setBlogPath"
        },
        {
          "command": "vsJournal.openEntry",
          "when": "false"
        },
        {
          "command": "vsJournal.searchByTag",
          "when": "false"
        },
        {
          "command": "vsJournal.uploadMedia"
        },
        {
          "command": "vsJournal.refreshMediaLibrary"
        }
      ]
    },
    "configuration": {
      "title": "Journal",
      "properties": {
        "vsJournal.blogPath": {
          "type": "string",
          "default": "./blog",
          "description": "Path to the blog directory relative to workspace root",
          "pattern": "^[^<>:\"|?*]+$",
          "patternErrorMessage": "Invalid path characters. Please use a valid directory path."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "typecheck": "tsc --noEmit -p ./",
    "watch": "tsc -watch -p ./",
    "prepare": "husky",
    "lint": "eslint src test --ext ts --ignore-pattern test/results/**",
    "lint:staged": "lint-staged",
    "release:check": "npm run compile && npm run lint && npm run test:unit && npm run test:release",
    "release:metadata": "node scripts/release-metadata.js --output-dir test/results/release",
    "package": "vsce package",
    "stage:sqlite3": "node scripts/stage-sqlite3-prebuild.js",
    "package:win32-x64": "node scripts/stage-sqlite3-prebuild.js win32-x64 && vsce package --target win32-x64",
    "package:darwin-x64": "node scripts/stage-sqlite3-prebuild.js darwin-x64 && vsce package --target darwin-x64",
    "package:darwin-arm64": "node scripts/stage-sqlite3-prebuild.js darwin-arm64 && vsce package --target darwin-arm64",
    "package:linux-x64": "node scripts/stage-sqlite3-prebuild.js linux-x64 && vsce package --target linux-x64",
    "package:linux-arm64": "node scripts/stage-sqlite3-prebuild.js linux-arm64 && vsce package --target linux-arm64",
    "package:alpine-x64": "node scripts/stage-sqlite3-prebuild.js alpine-x64 && vsce package --target alpine-x64",
    "package:alpine-arm64": "node scripts/stage-sqlite3-prebuild.js alpine-arm64 && vsce package --target alpine-arm64",
    "test:results": "node test/scripts/ensure-results.js",
    "test:compile": "npm run test:results && tsc -p test/tsconfig.json",
    "test:unit:run": "mocha --ui tdd --timeout 20000 \"test/results/compiled/test/unit/*.test.js\"",
    "test:unit": "npm run test:compile && npm run test:unit:run",
    "test:property:run": "mocha --ui tdd --timeout 20000 \"test/results/compiled/test/property/*.property.test.js\"",
    "test:property": "npm run test:compile && npm run test:property:run",
    "test:release": "mocha --ui tdd --timeout 20000 \"test/scripts/*.test.js\"",
    "test:acceptance:run": "node test/results/compiled/test/acceptance/runTest.js",
    "test:acceptance": "npm run compile && npm run test:compile && npm run test:acceptance:run",
    "test:integration": "npm run test:acceptance",
    "test:torture:run": "mocha --ui tdd --timeout 120000 \"test/results/compiled/test/torture/*.torture.test.js\"",
    "test:torture": "npm run test:compile && npm run test:torture:run",
    "test:mutation:runner": "npm run test:compile && mocha --ui tdd --timeout 20000 \"test/results/compiled/test/unit/{entryGrouping,frontmatter,pathUtils}.test.js\" \"test/results/compiled/test/property/*.property.test.js\"",
    "test:mutation": "npm run test:results && stryker run test/stryker.conf.json",
    "test:qa": "node test/scripts/run-qa.js",
    "test": "npm run test:qa"
  },
  "lint-staged": {
    "*.ts": "eslint"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@types/fs-extra": "^11.0.4",
    "@types/mocha": "^10.0.10",
    "@types/moment": "^2.13.0",
    "@types/node": "16.x",
    "@types/sqlite3": "^5.1.0",
    "@types/vscode": "1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^8.28.0",
    "fast-check": "^3.23.2",
    "husky": "^9.1.7",
    "lint-staged": "^13.2.3",
    "mocha": "^11.3.0",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "fs-extra": "^11.4.0",
    "moment": "^2.29.4",
    "sqlite3": "6.0.1"
  },
  "overrides": {
    "@types/node": "16.x",
    "@azure/core-util": "1.13.1",
    "@azure/core-auth": "1.10.1",
    "@azure/core-client": "1.10.2",
    "@azure/core-rest-pipeline": "1.23.0",
    "@azure/core-tracing": "1.3.1",
    "@azure/abort-controller": "2.1.2",
    "@azure/logger": "1.3.0",
    "@typespec/ts-http-runtime": "0.3.4"
  }
}
